# ============================================================
# PRODUCTION ENVIRONMENT — copy to .env.prod and fill in ALL values
# NEVER commit .env.prod to git
# ============================================================

# Database — use a strong password
DATABASE_URL=postgresql+asyncpg://jobcrm:CHANGE_ME_STRONG_PASSWORD@db:5432/jobcrm
DATABASE_URL_SYNC=postgresql://jobcrm:CHANGE_ME_STRONG_PASSWORD@db:5432/jobcrm
POSTGRES_USER=jobcrm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=jobcrm

# Redis — use a strong password
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_256BIT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Single-user credentials
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
CLAUDE_DAILY_BUDGET_USD=5.00

# Browser session encryption — generate with: python -c "import secrets; print(secrets.token_hex(32))"
BROWSER_SESSION_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety rate limits
MAX_APPLICATIONS_PER_DAY=10
MAX_JOBS_COLLECTED_PER_RUN=30
MAX_COLLECTION_RUNS_PER_DAY=4
PLAYWRIGHT_MIN_DELAY_MS=2000
PLAYWRIGHT_MAX_DELAY_MS=8000

# Storage
CV_UPLOAD_DIR=/app/uploads
MAX_CV_SIZE_BYTES=5242880

# App
ENVIRONMENT=production
LOG_LEVEL=WARNING
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost
